{
    "name": "stack/laravel-app-example",
    "type": "project",
    "description": "stack example -- minimal skeleton, not a full Laravel scaffold. See README.md.",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
